#!/bin/bash
# RAPTOR CLI wrapper - resolves install location and activates venv

RAPTOR_HOME="${RAPTOR_DIR:-$(cd "$(dirname "$0")" && pwd)}"
cd "$RAPTOR_HOME"

export RAPTOR_DIR="$RAPTOR_HOME"

if [ -f .env ]; then
    set -a
    source .env
    set +a
fi

export PATH="/opt/homebrew/bin:/opt/homebrew/sbin:$PATH"

if [ -f .venv/bin/activate ]; then
    source .venv/bin/activate
fi

exec python3 raptor.py "$@"
